# Copy to backend/.env for local development. Never commit the real .env.
# On Render / Vercel these go in the dashboard's environment variables instead.

# --- required ---
GROQ_API_KEY=
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- LLM ---
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_STRONG=openai/gpt-oss-20b
MAX_OUTPUT_TOKENS=1500
HISTORY_TURNS=2
LLM_REASONING_EFFORT=low

# --- embeddings: "gemini" (hosted, no RAM), "fastembed" (local ONNX) or "local" (torch) ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GEMINI_API_KEY=
# Changing provider or model means a NEW collection and re-uploading documents.
QDRANT_COLLECTION=chunks_gemini
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# --- retrieval ---
CONTEXT_TOP_N=5
RELEVANCE_THRESHOLD=0.15
HYBRID_ENABLED=true
RERANK_ENABLED=false
REWRITE_ENABLED=false

# --- web search (Tavily first, DuckDuckGo as fallback) ---
TAVILY_API_KEY=

# --- cache / quota / rate limits (need Redis; they fail open if Redis is down) ---
# Upstash: rediss://default:PASSWORD@HOST:6379  (two s in rediss)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=true
CACHE_TTL_S=3600
DAILY_TOKEN_QUOTA=50000
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_AUTH_PER_MIN=10

# --- uploads / chunking ---
MAX_UPLOAD_MB=25
CHUNK_SIZE_CHARS=400
CHUNK_OVERLAP_CHARS=60

# --- OCR (scanned PDFs; needs tesseract on the machine) ---
OCR_ENABLED=false
OCR_LANG=eng+hin
OCR_DPI=300
OCR_MIN_CHARS=50
OCR_MAX_PAGES=100

# --- observability ---
LOG_FORMAT=text
LOG_LEVEL=INFO
METRICS_ENABLED=true
# Leave EMPTY with no trailing comment on the same line.
METRICS_TOKEN=
TRACE_CONTENT=false
# Error alerts (Sentry free plan). Empty = off.
SENTRY_DSN=
# Owner-only usage numbers at GET /admin/usage, sent as the X-Admin-Token header. Empty = endpoint off.
ADMIN_TOKEN=

# --- CORS (frontend origin, no trailing slash) ---
CORS_ORIGINS=http://localhost:3000

# --- local dev ---
DB_AUTO_CREATE=true
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
INGEST_MODE=inline
STORAGE_BACKEND=local
